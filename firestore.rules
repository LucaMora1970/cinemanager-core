rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /films/{id}        { allow read: if true; allow write: if request.auth != null; }
    match /shows/{id}        { allow read: if true; allow write: if request.auth != null; }
    match /staff/{id}        { allow read, write: if request.auth != null; }
    match /shifts/{id}       { allow read, write: if request.auth != null; }
    match /settings/{id}     {
      allow read: if id == 'pubFlag' || id == 'boRanking' || id == 'boWeekend' || request.auth != null;
      allow write: if request.auth != null;
    }
    match /oaClienti/{id}    { allow read, write: if request.auth != null; }
    match /oaLuoghi/{id}     { allow read, write: if request.auth != null; }
    match /oaAddetti/{id}    { allow read, write: if request.auth != null; }
    match /bookings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /oaSlots/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /oaServizi/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /oaListini/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /oaRichieste/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /richiesteEventi/{id} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    match /campaigns/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /agencies/{doc} {
      allow read, write: if request.auth != null;
    }
    match /presenze/{id} {
      allow read, write: if request.auth != null;
    }
    match /sessioni/{id} {
      allow read, write: if request.auth != null;
    }
    match /proposta/{id} {
      allow read, write: if request.auth != null;
    }
    match /boData/{id} {
      allow read, write: if request.auth != null;
    }
    match /incassi/{id} {
      allow read, write: if request.auth != null;
    }
    match /startliste/{id} {
      allow read, write: if request.auth != null;
    }
  }
}