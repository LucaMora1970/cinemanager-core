rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /films/{id}        { allow read: if true; allow write: if request.auth != null; }
    match /shows/{id}        { allow read: if true; allow write: if request.auth != null; }
    match /staff/{id}        { allow read, write: if request.auth != null; }
    match /shifts/{id}       { allow read, write: if request.auth != null; }
    match /settings/{id}     {
      allow read: if id == 'pubFlag' || id == 'boRanking' || id == 'boWeekend' || id == 'compleanno' || id == 'richiesteStaff' || id == 'salaPrivataFilm' || request.auth != null;
      allow write: if request.auth != null;
    }
    match /oaClienti/{id}    { allow read, write: if request.auth != null; }
    match /oaLuoghi/{id}     { allow read, write: if request.auth != null; }
    match /oaAddetti/{id}    { allow read, write: if request.auth != null; }
    match /bookings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /oaSlots/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /oaServizi/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /salaPrivataServizi/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /eventiSpeciali/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /oaListini/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /oaRichieste/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /richiesteEventi/{id} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if true;
      // Il cliente può confermare o annullare una proposta dalla pagina di stato
      // pubblica (richiesta.html): solo quella transizione di stato, solo quei
      // due campi, e solo partendo da "proposta_inviata" — nient'altro
      allow update: if request.auth != null || (
        resource.data.stato == 'proposta_inviata' &&
        request.resource.data.stato in ['accettata', 'rifiutata'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'updatedAt'])
      ) || (
        // Compleanni: il prezzo è calcolo puro (nessuna trattativa), quindi il
        // cliente può accettare/rifiutare il preventivo automatico direttamente
        // da "nuova", registrando anche il testo mostrato (campo "proposta") e
        // aprendo l'attesa di conferma da parte di un responsabile
        resource.data.tipo == 'compleanno' &&
        resource.data.stato == 'nuova' &&
        request.resource.data.stato in ['accettata', 'rifiutata'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'updatedAt', 'proposta', 'staffApprovazione'])
      ) || (
        // Un responsabile clicca "approva" o "rifiuta" dal link ricevuto via
        // email — solo la primissima risposta viene accettata: il campo
        // stesso fa da lucchetto contro doppi click/risposte concorrenti
        resource.data.staffApprovazione == 'in_attesa' &&
        (
          (request.resource.data.staffApprovazione == 'approvata' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staffApprovazione', 'updatedAt'])) ||
          (request.resource.data.staffApprovazione == 'rifiutata' &&
           request.resource.data.stato == 'rifiutata' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staffApprovazione', 'stato', 'updatedAt']))
        )
      );
      allow delete: if request.auth != null;
    }
    match /campaigns/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /agencies/{doc} {
      allow read, write: if request.auth != null;
    }
    match /presenze/{id} {
      allow read, write: if request.auth != null;
    }
    match /sessioni/{id} {
      allow read, write: if request.auth != null;
    }
    match /proposta/{id} {
      allow read, write: if request.auth != null;
    }
    match /boData/{id} {
      allow read, write: if request.auth != null;
    }
    match /incassi/{id} {
      allow read, write: if request.auth != null;
    }
    match /startliste/{id} {
      allow read, write: if request.auth != null;
    }
    match /promoCodes/{id} {
      allow read, write: if request.auth != null;
    }
    match /codiciAssegnati/{id} {
      allow read, write: if request.auth != null;
    }
    // Voti "Concorso: I più attesi": due categorie (normale/cinewow, dedotte
    // dal flag cinewow già esistente sui film), un voto a testa PER
    // CATEGORIA — id documento deterministico email+categoria (vedi
    // piu-attesi.html) così un secondo voto nella stessa categoria è un
    // "update", non una "create": bloccato per il pubblico qui, non solo
    // lato client
    match /piuAttesiVoti/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['filmId','category','email','votedAt'])
        && request.resource.data.filmId is string && request.resource.data.filmId.size() > 0
        && request.resource.data.category in ['normale','cinewow']
        && request.resource.data.email is string && request.resource.data.email.size() > 3
        && request.resource.data.votedAt is string;
      allow update, delete: if request.auth != null;
    }
  }
}