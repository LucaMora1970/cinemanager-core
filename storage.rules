rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    match /oa/{bookingId}/{dateIdx}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf')
                   && request.resource.size <= 20 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    match /docs/{fileName} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null;
    }

    match /films/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    match /eventi/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Foto delle card "Perché il Cinematografo Ambulante" in home su
    // cinema-ambulante (sito separato, stesso progetto Firebase) — lettura
    // pubblica non autenticata, come /eventi/
    match /cardsAmbulante/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Immagini della home di Cinetour.ch (header + "Serate magiche") —
    // lettura pubblica come /eventi/
    match /cinetourHome/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // Poster/backdrop/foto-luogo delle serate Cinetour.ch (Fase 7 del
    // Dossier OA — sito pubblico separato, stesso progetto Firebase) —
    // lettura pubblica come /eventi/
    match /cinetourPubblico/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // CV allegato al modulo pubblico "Lavora con noi" (lavora-con-noi.html):
    // upload non autenticato come richiesteEventi (allow create:if true in
    // firestore.rules, stesso principio) — chiunque può scrivere un nuovo
    // file PDF qui, nessuno (tranne lo staff) può rileggerli in blocco
    match /candidature/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.resource.contentType == 'application/pdf'
                   && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
